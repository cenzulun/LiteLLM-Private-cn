PLATFORM=linux/arm64
BIND_ADDRESS=127.0.0.1
WEB_PORT=4100
GATEWAY_IMAGE=realai/gateway:1.0.20-arm64
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
DATABASE_URL=postgresql://用户名:密码@内网PG地址:5432/数据库名
REDIS_HOST=内网Redis地址
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_SSL=false
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
UI_USERNAME=admin
UI_PASSWORD=
PROMETHEUS_URL=
REALAI_METRIC_ROUTING_ENABLED=false
REALAI_ROUTING_METRIC_QUERY=sum(vllm:num_requests_waiting) by (model_name,instance) + sum(vllm:num_requests_running) by (model_name,instance)
REALAI_ROUTING_METRIC_REFRESH_SECONDS=10

MOTOR_IMAGE=realai/motor:3.2.0-runtime-arm64

REPORT_MODEL_TIMEOUT_SECONDS=300
DIRECT_MONITOR_MAX_SAMPLES=2000000
